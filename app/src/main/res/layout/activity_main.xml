<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Prompt to HTML"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste your prompt here:"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/promptInput"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="top|start"
            android:hint="Paste the prompt text here..."
            android:background="@android:drawable/editbox_background"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:padding="8dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:importantForAutofill="no"
            android:isScrollContainer="true"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls" />

        <Button
            android:id="@+id/addImageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add Image" />

        <TextView
            android:id="@+id/imageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No image attached"
            android:padding="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paste the AI response here:"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/responseInput"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:gravity="top|start"
            android:hint="Paste the AI response or code here..."
            android:background="@android:drawable/editbox_background"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:padding="8dp"
            android:inputType="textMultiLine|textNoSuggestions"
            android:importantForAutofill="no"
            android:isScrollContainer="true"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls" />

        <Button
            android:id="@+id/addTurnButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add New Conversation" />

        <Button
            android:id="@+id/cancelEditButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Cancel Editing"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/turnsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp" />

        <Button
            android:id="@+id/deleteAllButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Delete All Conversations" />

        <Button
            android:id="@+id/importHtmlButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Import HTML (add an old file)" />

        <Button
            android:id="@+id/generateHtmlButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Generate HTML (AI Safe)" />

    </LinearLayout>

</ScrollView>
